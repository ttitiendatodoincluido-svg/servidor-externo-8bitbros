[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Codigo/panel_servidor_externo.gd" id="1_pse001"]

[node name="PanelServidorExterno" type="VBoxContainer"]
theme_override_constants/separation = 10
