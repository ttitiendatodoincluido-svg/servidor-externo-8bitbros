[node name="EtiquetaAyuda" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 2
text = "For playing with someone who is NOT on your WiFi network. You both need the same server address (already filled in by default) and the same room code."

[node name="CampoServidor" type="LineEdit" parent="."]
layout_mode = 2
