[node name="Salta" type="Label" parent="." unique_id=156985117]
offset_left = -998.0
offset_top = -41.0
offset_right = -780.0
offset_bottom = 46.0
theme_override_colors/font_color = Color(0.0117647, 0.14902, 0.34902, 1)
theme_override_fonts/font = ExtResource("14_m48xp")
theme_override_font_sizes/font_size = 12
text = "이 튜토리얼에 오신 것을 환영합니다!
왼쪽으로 이동하려면 A 키 또는 < 키를 누르세요.
오른쪽으로 이동하려면 D 키 또는 > 키를 누르세요."
autowrap_mode = 2

[node name="Salta4" type="Label" parent="." unique_id=1432166627]
offset_left = -765.0
offset_top = -19.0
offset_right = -547.0
offset_bottom = 68.0
theme_override_colors/font_color = Color(0.0117647, 0.14902, 0.34902, 1)
theme_override_fonts/font = ExtResource("14_m48xp")
theme_override_font_sizes/font_size = 12
text = "점프하려면 스페이스바, W 또는 ⌃를 누르세요"
autowrap_mode = 2

[node name="Salta5" type="Label" parent="." unique_id=2003467817]
offset_left = -518.0
offset_top = -27.0
offset_right = -371.0
offset_bottom = 60.0
theme_override_colors/font_color = Color(0.0117647, 0.14902, 0.34902, 1)
theme_override_fonts/font = ExtResource("14_m48xp")
theme_override_font_sizes/font_size = 12
text = "적 조심해! 걔가 널 없앨 수 있어 그리고 다시 시작 게 만들 거야. 그걸 뛰어넘어!"
autowrap_mode = 2

[node name="Salta6" type="Label" parent="." unique_id=413422562]
offset_left = -349.0
offset_top = -37.0
offset_right = -161.0
offset_bottom = 50.0
theme_override_colors/font_color = Color(0.0117647, 0.14902, 0.34902, 1)
theme_override_fonts/font = ExtResource("14_m48xp")
theme_override_font_sizes/font_size = 12
text = "여기 당신은 트램펄린을 가지고 있습니다 이것은 당신을 점프하게 만들고 당신이 레벨을 쉽게 통과하도록 도와줄 것입니다. 시도해 보세요!"
autowrap_mode = 2

[node name="Salta7" type="Label" parent="." unique_id=1684678460]
offset_left = -143.0
offset_top = -18.0
offset_right = 1.0
offset_bottom = 69.0
theme_override_colors/font_color = Color(0.0117647, 0.14902, 0.34902, 1)
theme_override_fonts/font = ExtResource("14_m48xp")
theme_override_font_sizes/font_size = 12
text = "봐라, 동전 하나 당신은 그것을 줍다 전체에 걸쳐 레벨"
