; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="8-Bit Bros"
config/description="Sumérgete en la experiencia de 8-Bit Bros, un título de Aventura diseñado para que cada partida sea diferente y emocionante.

Explora escenarios, supera retos y pon a prueba tus habilidades mientras disfrutas de un mundo lleno de niveles y diversión sin fin.

Características principales:

✅ Gráficos envolventes y optimizados para móviles.

✅ Controles simples e intuitivos.

✅ Desafíos progresivos que aumentan la dificultad.

✅ Un jugador y offline.

✅ Compatible con una amplia gama de dispositivos con Windows.

Ya sea que quieras jugar unos minutos o perderte durante horas, 8-Bit Bros está listo para acompañarte en todo momento.

📲 ¡Descárgalo ahora y empieza la aventura!"
config/version="1.3"
run/main_scene="uid://0r0x2ppuhws8"
config/features=PackedStringArray("4.8", "Forward Plus")
boot_splash/image="uid://bbms2vwq7s7ym"
config/icon="uid://c77k2r8w0ljh"
config/windows_native_icon="res://logo-8-bit.ico"
boot_splash/minimum_display_time=2000

[audio]

buses/default_bus_layout="uid://qlpe04dvoyfg"

[autoload]

Musica="*res://Escenas/musica.tscn"
Red="*res://Codigo/red.gd"
Carrera="*res://Codigo/carrera.gd"
Guardado="*res://Codigo/guardado.gd"
Skins="*res://Codigo/skins.gd"
Notificaciones="*res://Codigo/notificaciones.gd"
VerificadorActualizaciones="*res://Codigo/verificador_actualizaciones.gd"

[display]

window/size/mode=3
window/stretch/mode="viewport"

